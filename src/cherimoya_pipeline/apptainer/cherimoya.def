Bootstrap: docker
From: pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        git wget curl build-essential \
        samtools bedtools tabix \
        libcurl4-openssl-dev libssl-dev libbz2-dev liblzma-dev zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    # This image's Python is the Ubuntu 24.04 system Python, which refuses
    # bare `pip install` under PEP 668 ("externally-managed-environment").
    # That protection exists to keep pip from clobbering apt-managed
    # packages on a real, shared system; it doesn't apply to a
    # single-purpose container image being built for this one application,
    # so --break-system-packages on every install below is safe here.

    # Don't touch setuptools; there's no need to for a --no-deps install
    # below, and some base torch builds pin it against their own build.
    python -m pip install --break-system-packages --upgrade pip wheel

    # Install the non-Cherimoya, non-torch pyproject.toml dependencies while
    # preserving the base image's own torch/torchvision build (torch 2.13.0,
    # CUDA 12.6). h5py and modisco aren't direct pyproject dependencies, but
    # Cherimoya itself depends on them at import time, and modisco/launch.py
    # runs `modisco motifs`/`modisco report` directly inside this image;
    # installing them here (rather than letting `pip install cherimoya`
    # below pull h5py in) avoids a separate, unpinned resolve of leidenalg --
    # modisco's own leidenalg dependency is unpinned, so listing
    # leidenalg==0.10.2 alongside it in this single `pip install` lets pip's
    # resolver settle on the pinned version for both.
    python -m pip install --break-system-packages \
        h5py huggingface-hub joblib ledidi "leidenalg==0.10.2" matplotlib \
        modisco numpy pandas pillow pybigtools pyfaidx pyyaml \
        scikit-learn scipy seaborn "tangermeme>=1.4.0" tqdm

    # bpnet-lite declares an unconditional macs3 dependency that nothing in
    # this pipeline calls; --no-deps skips it (bpnetlite.performance, the
    # only submodule Cherimoya's scripts import, only needs torch and its
    # own .losses module, both already present).
    python -m pip install --break-system-packages --no-deps bam2bw bpnet-lite

    # Cherimoya + daicon. --no-deps avoids replacing the base image's torch
    # 2.13.0 build with a fresh PyPI resolve of cherimoya's own
    # torch>=2.9.0 requirement.
    python -m pip install --break-system-packages --no-deps cherimoya daicon

    # Optional but useful for source/debugging
    python -m pip install --break-system-packages pytest ipython

%environment
    export PYTHONNOUSERSITE=1
    export NUMBA_CACHE_DIR=/tmp/numba_cache/
    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec "$@"
